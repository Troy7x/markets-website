{
  "name": "water-resources-presentation",
  "version": "1.0.0",
  "description": "Water Resources Engineering Presentation Website",
  "scripts": {
    "build": "tsc && tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "dev": "tsc --watch & tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "start": "tsc && tailwindcss -i ./src/input.css -o ./dist/output.css"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}

